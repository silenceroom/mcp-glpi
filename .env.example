# Template for docker compose (`cp .env.example .env`) and for `docker run
# --env-file .env`. The same loader is used by `npm run smoke`.
#
# .env is gitignored — never commit the filled-in copy.

# --- GLPI connection (required) ------------------------------------------

GLPI_URL=https://glpi.example.com

# Application token — Setup → General → API. Optional.
GLPI_APP_TOKEN=

# Authenticate with either a user token …
GLPI_USER_TOKEN=
# … or a login + password.
GLPI_USERNAME=
GLPI_PASSWORD=

# --- Tuning (optional) ---------------------------------------------------

# HTTP request timeout in ms (default 15000).
# GLPI_TIMEOUT_MS=15000
# Max retries on 5xx / 429 / network errors (default 2).
# GLPI_MAX_RETRIES=2
# Log HTTP retries / re-auth to stderr.
# GLPI_DEBUG=

# --- HTTP transport (optional) -------------------------------------------
# docker-compose.yml already sets the first three; they are listed here for
# `docker run` users.

# MCP_TRANSPORT=http
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3000
# MCP_HTTP_PATH=/mcp
# Require `Authorization: Bearer <token>` on every MCP request.
# MCP_HTTP_AUTH_TOKEN=
# Comma-separated Host-header allowlist.
# MCP_HTTP_ALLOWED_HOSTS=
